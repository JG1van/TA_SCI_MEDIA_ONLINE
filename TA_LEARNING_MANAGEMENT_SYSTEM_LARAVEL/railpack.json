{
    "php": {
        "extensions": [
            "gd",
            "exif",
            "pdo",
            "pdo_mysql",
            "mbstring",
            "tokenizer",
            "xml",
            "ctype",
            "fileinfo",
            "bcmath",
            "curl",
            "zip",
            "redis"
        ]
    },
    "deploy": {
        "startCommand": "php artisan storage:link 2>/dev/null; php artisan schedule:work & php artisan serve --host=0.0.0.0 --port=$PORT"
    }
}
